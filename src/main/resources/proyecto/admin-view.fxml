<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="proyecto.viewController.AdminViewController">
    <top>
        <HBox spacing="12" style="-fx-background-color: #dddddd;">
            <padding><Insets bottom="10" left="10" right="10" top="10" /></padding>
            <Label fx:id="lblBienvenida" />
            <Button onAction="#onSalir" prefHeight="25.0" prefWidth="450.0" text="Cerrar sesion" />
        </HBox>
    </top>
    <center>
        <TabPane tabClosingPolicy="UNAVAILABLE">
            <tabs>
            <Tab text="Recepcionistas">
                <content>
                    <ScrollPane fitToWidth="true">
                        <content>
                            <VBox spacing="8">
                                <padding><Insets bottom="10" left="10" right="10" top="10" /></padding>
                                <ListView fx:id="lstRecepcionistas" prefHeight="150" />
                        <HBox spacing="8"><Label minWidth="170" text="Nombre" /><TextField fx:id="txtRNombre" /></HBox>
                        <HBox spacing="8"><Label minWidth="170" text="Documento" /><TextField fx:id="txtRDocumento" /></HBox>
                        <HBox spacing="8"><Label minWidth="170" text="Telefono" /><TextField fx:id="txtRTelefono" /></HBox>
                        <HBox spacing="8"><Label minWidth="170" text="Correo" /><TextField fx:id="txtRCorreo" /></HBox>
                        <HBox spacing="8"><Label minWidth="170" text="Usuario" /><TextField fx:id="txtRUsuario" /></HBox>
                        <HBox spacing="8"><Label minWidth="170" text="Contrasena" /><PasswordField fx:id="txtRClave" /></HBox>
                        <HBox spacing="8"><Button onAction="#onContratar" text="Contratar" /><Button onAction="#onEditarRecepcionista" text="Editar nombre, telefono y correo" /><Button onAction="#onDesvincular" text="Desvincular" /></HBox>
                            </VBox>
                        </content>
                    </ScrollPane>
                </content>
            </Tab>
            <Tab text="Apartamentos">
                <content>
                    <ScrollPane fitToWidth="true">
                        <content>
                            <VBox spacing="8">
                                <padding><Insets bottom="10" left="10" right="10" top="10" /></padding>
                                <ListView fx:id="lstApartamentos" prefHeight="150" />
                        <HBox spacing="8"><Label minWidth="170" text="Codigo" /><TextField fx:id="txtCodigo" /></HBox>
                        <HBox spacing="8"><Label minWidth="170" text="Nombre" /><TextField fx:id="txtNombre" /></HBox>
                        <HBox spacing="8"><Label minWidth="170" text="Dormitorios" /><TextField fx:id="txtDormitorios" /></HBox>
                        <HBox spacing="8"><Label minWidth="170" text="Capacidad" /><TextField fx:id="txtCapacidad" /></HBox>
                        <HBox spacing="8"><Label minWidth="170" text="Caracteristicas" /><TextField fx:id="txtCaracteristicas" /></HBox>
                        <HBox spacing="8"><Label minWidth="170" text="Tarifa baja" /><TextField fx:id="txtTarifaBaja" /></HBox>
                        <HBox spacing="8"><Label minWidth="170" text="Tarifa media" /><TextField fx:id="txtTarifaMedia" /></HBox>
                        <HBox spacing="8"><Label minWidth="170" text="Tarifa alta" /><TextField fx:id="txtTarifaAlta" /></HBox>
                        <HBox spacing="8"><Button onAction="#onCrearApartamento" text="Crear" /><Button onAction="#onModificarApartamento" text="Modificar el seleccionado" /><Button onAction="#onEliminarApartamento" text="Eliminar el seleccionado" /></HBox>
                            </VBox>
                        </content>
                    </ScrollPane>
                </content>
            </Tab>
            <Tab text="Temporadas y politica">
                <content>
                    <ScrollPane fitToWidth="true">
                        <content>
                            <VBox spacing="8">
                                <padding><Insets bottom="10" left="10" right="10" top="10" /></padding>
                                <HBox spacing="8"><Label minWidth="170" text="Temporada" /><ComboBox fx:id="cmbTemporada" /></HBox>
                        <HBox spacing="8"><Label minWidth="170" text="Desde" /><TextField fx:id="txtPeriodoDesde" promptText="aaaa-mm-dd" /></HBox>
                        <HBox spacing="8"><Label minWidth="170" text="Hasta" /><TextField fx:id="txtPeriodoHasta" promptText="aaaa-mm-dd" /></HBox>
                        <HBox spacing="8"><Button onAction="#onAgregarPeriodo" text="Agregar periodo" /></HBox>
                        <ListView fx:id="lstPeriodos" prefHeight="120" />
                        <HBox spacing="8"><Button onAction="#onEliminarPeriodo" text="Eliminar periodo" /></HBox>
                        <Label text="POLITICA DE CANCELACION" />
                        <HBox spacing="8"><Label minWidth="260" text="Dias para devolucion total (mas de)" /><TextField fx:id="txtDias" /></HBox>
                        <HBox spacing="8"><Label minWidth="260" text="Horas minimas para retencion parcial" /><TextField fx:id="txtHoras" /></HBox>
                        <HBox spacing="8"><Label minWidth="260" text="Porcentaje retenido en el tramo parcial" /><TextField fx:id="txtPorcentaje" /></HBox>
                        <HBox spacing="8"><Button onAction="#onGuardarPolitica" text="Guardar politica" /></HBox>
                            </VBox>
                        </content>
                    </ScrollPane>
                </content>
            </Tab>
            <Tab text="Bloqueos">
                <content>
                    <ScrollPane fitToWidth="true">
                        <content>
                            <VBox spacing="8">
                                <padding><Insets bottom="10" left="10" right="10" top="10" /></padding>
                                <HBox spacing="8"><Label minWidth="170" text="Apartamento" /><ComboBox fx:id="cmbApartamento" /></HBox>
                        <HBox spacing="8"><Label minWidth="170" text="Desde" /><TextField fx:id="txtBloqueoDesde" promptText="aaaa-mm-dd" /></HBox>
                        <HBox spacing="8"><Label minWidth="170" text="Hasta" /><TextField fx:id="txtBloqueoHasta" promptText="aaaa-mm-dd" /></HBox>
                        <HBox spacing="8"><Label minWidth="170" text="Motivo" /><TextField fx:id="txtBloqueoMotivo" /></HBox>
                        <HBox spacing="8"><Button onAction="#onBloquear" text="Registrar bloqueo" /></HBox>
                        <ListView fx:id="lstBloqueos" prefHeight="150" />
                        <HBox spacing="8"><Button onAction="#onEliminarBloqueo" text="Eliminar bloqueo" /></HBox>
                            </VBox>
                        </content>
                    </ScrollPane>
                </content>
            </Tab>
            <Tab text="Reportes">
                <content>
                    <ScrollPane fitToWidth="true">
                        <content>
                            <VBox spacing="8">
                                <padding><Insets bottom="10" left="10" right="10" top="10" /></padding>
                                <HBox spacing="8"><Label minWidth="170" text="Desde" /><TextField fx:id="txtReporteDesde" promptText="aaaa-mm-dd" /></HBox>
                        <HBox spacing="8"><Label minWidth="170" text="Hasta" /><TextField fx:id="txtReporteHasta" promptText="aaaa-mm-dd" /></HBox>
                        <HBox spacing="8"><Button onAction="#onReporteOcupacion" text="Ocupacion" /><Button onAction="#onReporteIngresos" text="Ingresos" /><Button onAction="#onReporteCanales" text="Reservas por canal" /><Button onAction="#onReporteSaldos" text="Saldos pendientes" /><Button onAction="#onReporteNovedades" text="Novedades" /></HBox>
                        <TextArea fx:id="txtReporte" editable="false" prefRowCount="18" />
                            </VBox>
                        </content>
                    </ScrollPane>
                </content>
            </Tab>
                <Tab text="Huespedes">
                    <content>
                        <ScrollPane fitToWidth="true">
                            <content>
                                <VBox spacing="8">
                                    <padding><Insets bottom="10" left="10" right="10" top="10" /></padding>
                                    <ListView fx:id="lstHuespedes" prefHeight="400" />
                                </VBox>
                            </content>
                        </ScrollPane>
                    </content>
                </Tab>
            </tabs>
        </TabPane>
    </center>
</BorderPane>